# The two fleet compose files that pin ghcr.io/metrolla-inc/ouster-ros-driver:v1.0.0 (balena-fleets
# and balena-fleets-metrollaprod, one fleet each, docker-compose.yml and docker-compose-ros2.yml
# with DRIVER_VERSION=v1.0.0): service met_lidar_driver, network_mode host, ipc host, no command
# (the image's CMD runs), environment exactly these two variables.
ROS_LOCALHOST_ONLY=1
USE_MACADDRESS_NS=0
