# The fleets' .env files carry SENSOR_TYPE, SENSOR_IP and SENSOR_PORT (not passed to this service
# today). Even if they reached the container, the legacy image ignores them: its command names
# the sensor. So do the contract's own names without the switch.
ROS_LOCALHOST_ONLY=1
USE_MACADDRESS_NS=0
SENSOR_TYPE=ouster
SENSOR_IP=192.168.1.201
SENSOR_PORT=2368
LIDAR_MODEL=os1-128
DATA_PORT=7502
